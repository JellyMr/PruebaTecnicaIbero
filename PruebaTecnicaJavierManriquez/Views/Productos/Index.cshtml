@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">Catálogo de productos</h4>
        </div>

        <div class="card-body">

            <div id="mensaje"></div>

            <form id="formProducto">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label for="nombre" class="form-label">
                            Nombre
                        </label>

                        <input type="text"
                               class="form-control"
                               id="nombre"
                               maxlength="150">

                        <div class="invalid-feedback">
                            El nombre es obligatorio.
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="descripcion" class="form-label">
                            Descripción
                        </label>

                        <input type="text"
                               class="form-control"
                               id="descripcion"
                               maxlength="500">
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label for="precio" class="form-label">
                            Precio
                        </label>

                        <input type="number"
                               class="form-control"
                               id="precio"
                               min="0.01"
                               step="0.01">

                        <div class="invalid-feedback">
                            El precio debe ser mayor a 0.
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="existencia" class="form-label">
                            Existencia
                        </label>

                        <input type="number"
                               class="form-control"
                               id="existencia"
                               min="0"
                               step="1">

                        <div class="invalid-feedback">
                            La existencia no puede ser negativa.
                        </div>
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary"
                        id="btnGuardar">
                    Guardar producto
                </button>

            </form>

        </div>
    </div>


    <div class="card shadow-sm mt-4">

        <div class="card-header">
            <h4 class="mb-0">Productos activos</h4>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Existencia</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody id="tablaProductos">
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/producto.js"></script>
}